// Fresh clone: open SightLatch.xcodeproj and select the same Team on all targets.
// Team-scoped defaults avoid the shared com.example identifier. The literal
// "team" keeps the identifier syntactically valid in unsigned simulator builds.
// Keep existing registered identifiers in Local.xcconfig when upgrading an install.
PILOT_BUNDLE_PREFIX = com.sightlatch.team$(DEVELOPMENT_TEAM).HIDPilot
PILOT_APP_GROUP = group.$(PILOT_BUNDLE_PREFIX)
// AppIdentifierPrefix is supplied by signing; it is not always the Team ID.
PILOT_KEYCHAIN_GROUP = $(AppIdentifierPrefix)$(PILOT_BUNDLE_PREFIX).shared
SWIFT_VERSION = 5.0
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1
CODE_SIGN_STYLE = Automatic
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Optional local signing overrides are ignored by Git and survive source updates.
#include? "Local.xcconfig"
